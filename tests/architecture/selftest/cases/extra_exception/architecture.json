    "synth_impl": { "deps": ["synth_types"], "external": ["Qt6::Network"] },
    "synth_yaml": { "deps": ["synth_types"], "external": [] }
  },
  "consumers": {},
  "include_rules": [],
  "exceptions": [
    {
      "id": "SELFTEST-D2-shaped-edge",
      "class": "architecture",
      "kind": "target_edge",
      "from": "synth_impl",
      "to": "synth_platform",
      "owner": "SELFTEST",
      "remove_in": "never",
