{
  "_about": "R4 ratchet. The named exception still matches and must NOT fail; the second edge must fail with ARCH-R1-FORBIDDEN-EDGE for synth_yaml -> synth_platform.",
  "ignore_external": ["Qt6::Platform"],
  "forbidden_external": ["Qt6::Widgets", "Qt6::Quick", "Qt6::Graphs"],
  "modules": {
    "synth_types": { "deps": [], "external": ["Qt6::Core"] },
